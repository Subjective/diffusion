{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["**", "!!**/dist"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Non-null assertions are used deliberately where an invariant guarantees a value.
        "noNonNullAssertion": "off",
        // Stylesheets are grouped by component, so a base rule can follow a more specific contextual one;
        // specificity, not source order, decides those cases.
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        // Index keys are fine for static lists derived from immutable model output.
        "noArrayIndexKey": "off"
      },
      "a11y": {
        // Keyboard and screen-reader support for the diff and guide panes is a separate pass.
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useKeyWithMouseEvents": "off",
        "noSvgWithoutTitle": "off"
      }
    }
  }
}
