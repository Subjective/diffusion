{
  "$defs": {
    "ArrowDraft": {
      "properties": {
        "from": {
          "description": "Block id.",
          "title": "From",
          "type": "string"
        },
        "to": {
          "description": "Block id.",
          "title": "To",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u2264 2 words, e.g. 'fires', 'tokens'.",
          "title": "Label"
        },
        "kind": {
          "default": "call",
          "description": "'call', 'data' (a value passed along), 'event' (async), or 'error'.",
          "enum": [
            "call",
            "data",
            "event",
            "error"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "ArrowDraft",
      "type": "object"
    },
    "BlockDraft": {
      "properties": {
        "id": {
          "description": "Short unique id within the view, e.g. 'refresh'.",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "What the reader sees: a function, type or component name, e.g. 'refresh()'.",
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "default": "box",
          "description": "'box' for a piece of code; 'region' groups boxes (a file, class or module).",
          "enum": [
            "box",
            "region"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the region this box sits in.",
          "title": "Parent"
        },
        "step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based index of the step that covers this block.",
          "title": "Step"
        },
        "refs": {
          "description": "The changed lines this block stands for. Leave empty for unchanged code shown as context.",
          "items": {
            "$ref": "#/$defs/LineRef"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "BlockDraft",
      "type": "object"
    },
    "CommentDraft": {
      "properties": {
        "title": {
          "description": "2\u20134 words naming the point, e.g. 'Never re-armed'.",
          "title": "Title",
          "type": "string"
        },
        "text": {
          "description": "1\u20132 sentences, \u2264 35 words. Inline `code` allowed.",
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "default": "note",
          "description": "'bug' for a likely defect, 'check' for something worth verifying, 'note' for context.",
          "enum": [
            "bug",
            "check",
            "note"
          ],
          "title": "Tone",
          "type": "string"
        },
        "refs": {
          "description": "The changed lines this comment is about.",
          "items": {
            "$ref": "#/$defs/LineRef"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "title",
        "text",
        "refs"
      ],
      "title": "CommentDraft",
      "type": "object"
    },
    "LineRef": {
      "description": "Changed lines as an agent cites them: a path and line numbers in the diff.",
      "properties": {
        "file": {
          "description": "Path of a changed file, relative to the repository root.",
          "title": "File",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First line on `side`; omit for every change in the file.",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last line, inclusive; defaults to `start`.",
          "title": "End"
        },
        "side": {
          "default": "new",
          "description": "'new' for added and unchanged lines (head numbers), 'old' for deleted lines.",
          "enum": [
            "new",
            "old"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "LineRef",
      "type": "object"
    },
    "SceneDraft": {
      "properties": {
        "title": {
          "description": "1\u20134 words, e.g. 'Arm the timer'.",
          "title": "Title",
          "type": "string"
        },
        "text": {
          "description": "1\u20132 sentences, \u2264 30 words. Inline `code` allowed.",
          "title": "Text",
          "type": "string"
        },
        "blocks": {
          "description": "Ids of the blocks this scene frames and lights.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based index of the step this scene tells.",
          "title": "Step"
        }
      },
      "required": [
        "title",
        "text",
        "blocks"
      ],
      "title": "SceneDraft",
      "type": "object"
    },
    "Scope": {
      "properties": {
        "files": {
          "description": "Paths or globs the guide covers; empty means the whole diff.",
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "note": {
          "default": "",
          "description": "What the reviewer asked to focus on, in a few words.",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SkipDraft": {
      "properties": {
        "file": {
          "description": "Path of a changed file, relative to the repository root.",
          "title": "File",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First line on `side`; omit for every change in the file.",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last line, inclusive; defaults to `start`.",
          "title": "End"
        },
        "side": {
          "default": "new",
          "description": "'new' for added and unchanged lines (head numbers), 'old' for deleted lines.",
          "enum": [
            "new",
            "old"
          ],
          "title": "Side",
          "type": "string"
        },
        "reason": {
          "enum": [
            "formatting",
            "trivial"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "reason"
      ],
      "title": "SkipDraft",
      "type": "object"
    },
    "StepDraft": {
      "properties": {
        "title": {
          "description": "1\u20133 words, e.g. 'Refresh loop'.",
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "enum": [
            "entry",
            "core",
            "contract",
            "wiring",
            "cleanup",
            "test",
            "config",
            "docs"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "description": "\u2264 25 words of markdown explaining what to look for. Inline `code` allowed.",
          "title": "Summary",
          "type": "string"
        },
        "refs": {
          "description": "Refs for the step as a whole. May be empty when substeps carry them.",
          "items": {
            "$ref": "#/$defs/LineRef"
          },
          "title": "Refs",
          "type": "array"
        },
        "substeps": {
          "description": "Ordered parts of this step to read one at a time.",
          "items": {
            "$ref": "#/$defs/SubstepDraft"
          },
          "maxItems": 8,
          "title": "Substeps",
          "type": "array"
        }
      },
      "required": [
        "title",
        "kind",
        "summary"
      ],
      "title": "StepDraft",
      "type": "object"
    },
    "SubstepDraft": {
      "properties": {
        "title": {
          "description": "1\u20134 words, e.g. 'Load affinity'.",
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "description": "\u2264 20 words: what this part does and what to check.",
          "title": "Summary",
          "type": "string"
        },
        "refs": {
          "description": "Narrow line ranges; several if the logic is split.",
          "items": {
            "$ref": "#/$defs/LineRef"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "title",
        "summary",
        "refs"
      ],
      "title": "SubstepDraft",
      "type": "object"
    },
    "ViewDraft": {
      "properties": {
        "title": {
          "description": "A few words, e.g. 'Token refresh'.",
          "title": "Title",
          "type": "string"
        },
        "layout": {
          "const": "flow",
          "default": "flow",
          "title": "Layout",
          "type": "string"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockDraft"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "arrows": {
          "items": {
            "$ref": "#/$defs/ArrowDraft"
          },
          "title": "Arrows",
          "type": "array"
        },
        "scenes": {
          "description": "A walk through the view, outside-in.",
          "items": {
            "$ref": "#/$defs/SceneDraft"
          },
          "maxItems": 10,
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "title",
        "blocks"
      ],
      "title": "ViewDraft",
      "type": "object"
    }
  },
  "properties": {
    "label": {
      "default": "",
      "description": "A few words naming this version, e.g. 'Split config step'.",
      "title": "Label",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when the review is narrowed to part of the diff."
    },
    "brief": {
      "default": "",
      "description": "What the reviewer cares about or already knows, passed on to chat.",
      "title": "Brief",
      "type": "string"
    },
    "tldr": {
      "description": "1\u20132 sentences: what changes and why it matters.",
      "title": "Tldr",
      "type": "string"
    },
    "comments": {
      "description": "Comments left on the changed lines they are about.",
      "items": {
        "$ref": "#/$defs/CommentDraft"
      },
      "maxItems": 8,
      "title": "Comments",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepDraft"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "views": {
      "description": "Diagrams of the change; the first is the overview.",
      "items": {
        "$ref": "#/$defs/ViewDraft"
      },
      "maxItems": 4,
      "title": "Views",
      "type": "array"
    },
    "skippable": {
      "description": "Changes that are pure formatting or trivially safe.",
      "items": {
        "$ref": "#/$defs/SkipDraft"
      },
      "title": "Skippable",
      "type": "array"
    }
  },
  "required": [
    "tldr",
    "steps"
  ],
  "title": "GuideDraft",
  "type": "object"
}
